# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.

# IMPORTANT: use the SECONDARY iSmart account, never the primary daily-driver account.
# See docs/planning/decisions_log.md for why, and setup steps if not done yet.
SAIC_USERNAME=
SAIC_PASSWORD=

# SAIC API region — MG Norway typically uses the EU region.
SAIC_REGION=eu

# SQLite database file path (relative to backend/ working directory)
DATABASE_PATH=data/mgs5.db
